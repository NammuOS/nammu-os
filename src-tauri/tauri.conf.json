{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nammu OS",
  "version": "4.1.0",
  "identifier": "com.nammu.os",
  "build": {
    "beforeDevCommand": "bun run desktop:web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run desktop:web:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nammu OS",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "connect-src": "'self' data: ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "font-src": "'self' data:",
        "frame-ancestors": "'self'",
        "frame-src": "'self' blob:",
        "img-src": "'self' data: blob: https:",
        "manifest-src": "'self'",
        "media-src": "'self' data: blob: https://audio.jukehost.co.uk",
        "object-src": "'self' blob:",
        "script-src": "'self' blob: 'wasm-unsafe-eval' 'sha256-/f2PB1WfMLxOSnxZvVSAjm3ejr569spnq4MPEnGfNGY='",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "credentialless",
        "Permissions-Policy": "geolocation=(self), cross-origin-isolated=(self)",
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nammu",
    "copyright": "Copyright © 2026 Nammu OS",
    "category": "Productivity",
    "shortDescription": "A local-first personal desktop workspace.",
    "longDescription": "Nammu OS is a local-first Windows workspace with a shared React interface, a native Windows web engine, native desktop capabilities, and a loopback-only local service runtime.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["resources/local-server"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
