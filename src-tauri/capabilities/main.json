{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the trusted Nammu shell webview only. Remote child webviews intentionally match no capability.",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "allow-get-local-service-info",
    "allow-authorize-local-request",
    "allow-list-native-file-roots",
    "allow-list-native-directory",
    "allow-stat-native-file",
    "allow-create-native-directory",
    "allow-create-native-file",
    "allow-rename-native-file",
    "allow-start-native-copy",
    "allow-start-native-move",
    "allow-start-native-duplicate",
    "allow-get-native-file-operation",
    "allow-cancel-native-file-operation",
    "allow-start-native-trash",
    "allow-start-native-permanent-delete",
    "allow-start-native-restore",
    "allow-get-native-deletion-operation",
    "allow-cancel-native-deletion-operation",
    "allow-start-native-directory-watch",
    "allow-stop-native-directory-watch",
    "allow-get-native-directory-watch-diagnostics",
    "allow-create-web-surface",
    "allow-destroy-web-surface",
    "allow-navigate-web-surface",
    "allow-control-web-surface",
    "allow-set-web-surface-bounds",
    "allow-set-web-surface-visibility",
    "allow-focus-web-surface",
    "allow-set-web-surface-zoom",
    "allow-get-web-surface-state",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
