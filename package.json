{
  "name": "nammu-os",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "clean": "bun run clean:generated && bun run clean:rust",
    "clean:generated": "node scripts/clean-generated.mjs",
    "clean:rust": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "dev": "node server.mjs --dev",
    "build": "next build",
    "start": "node server.mjs",
    "desktop:web:dev": "vite --config vite.desktop.config.ts",
    "desktop:web:build": "vite build --config vite.desktop.config.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "bun run desktop:release:prepare && tauri build --bundles nsis && bun run desktop:release:verify",
    "desktop:check": "bun run desktop:web:build && bun run desktop:rust:check",
    "desktop:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo check --manifest-path src-tauri/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:server:prepare": "node scripts/prepare-desktop-local-server.mjs",
    "desktop:server:smoke": "node scripts/smoke-desktop-local-server.mjs",
    "desktop:files:accept": "node scripts/accept-files-f2a.mjs",
    "desktop:files:delete:accept": "node scripts/accept-files-f2b.mjs",
    "desktop:files:watch:accept": "node scripts/accept-files-f2c.mjs",
    "desktop:files:search:accept": "node scripts/accept-files-f3a.mjs",
    "desktop:files:preview:accept": "node scripts/accept-files-f4a.mjs",
    "desktop:files:pdf:accept": "node scripts/accept-files-f4b.mjs",
    "desktop:files:video:accept": "node scripts/accept-files-f4c.mjs",
    "desktop:files:properties:accept": "node scripts/accept-files-f5a.mjs",
    "desktop:files:archive:accept": "node scripts/accept-files-f5b.mjs",
    "desktop:files:clipboard:accept": "node scripts/accept-files-f5c.mjs",
    "desktop:files:drag:accept": "node scripts/accept-files-f5d.mjs",
    "desktop:files:startup:smoke": "node scripts/smoke-files-startup.mjs",
    "desktop:release:prepare": "bun run build && bun run desktop:server:prepare && bun run desktop:server:smoke",
    "desktop:release:verify": "node scripts/verify-desktop-release.mjs",
    "firefox:patch": "node scripts/patch-firefox-wasm-release.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:screenshots": "node scripts/capture-readme-screenshots.mjs",
    "pdf:p3:smoke": "bun scripts/smoke-pdf-p3.mjs",
    "pdf:p4:smoke": "bun scripts/smoke-pdf-p4.mjs",
    "pdf:p8:smoke": "bun scripts/smoke-pdf-ocr.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests src/server/services/cloudProviderContracts.test.ts src/server/services/uploadTicketService.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/lib-storage": "^3.1065.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@mercuryworkshop/wisp-js": "0.4.1",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/supabase-js": "^2.99.1",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@trpc/client": "^11.13.0",
    "@trpc/react-query": "^11.13.0",
    "@trpc/server": "^11.13.0",
    "@types/js-yaml": "^4.0.9",
    "@types/qrcode": "^1.5.6",
    "@upstash/redis": "^1.38.2",
    "better-sqlite3": "^12.10.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "dropbox": "^10.34.0",
    "express": "^5.2.1",
    "fflate": "0.8.3",
    "framer-motion": "^12.35.0",
    "googleapis": "^173.0.0",
    "heic-decode": "^2.1.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.3.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "marked": "^18.0.9",
    "megajs": "^1.3.10",
    "next": "^16.3.1",
    "node-cron": "^4.2.1",
    "papaparse": "^5.6.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.624",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "sharp": "^0.35.3",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.2.1",
    "tesseract.js": "7.0.0",
    "uuid": "^14.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^5.1.1",
    "bun-types": "^1.4.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
