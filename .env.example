# ==============================================================================
#  🌌 NAMMU OS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
#  Architecture: Next.js 15 (App Router) + React 19 + tRPC v11 + Bun Runtime
#  Database: Supabase / PostgreSQL via Drizzle ORM
#  Cache: Redis / Upstash Distributed Caching
#  Security: AES-256-GCM Credential Vault + HMAC Session Signing
# ==============================================================================

# ==============================================================================
#  1. CORE APPLICATION RUNTIME
# ==============================================================================
# Execution environment mode ('development' | 'test' | 'production')
NODE_ENV=development

# Application port (Default: 3000 for Next.js App Router)
PORT=3000

# Canonical Public URL of the deployed Nammu OS instance (Used for OAuth redirects & metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Next.js telemetry collection (0 = disabled for privacy & performance)
NEXT_TELEMETRY_DISABLED=1

# Log verbosity ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info


# ==============================================================================
#  2. DATABASE & STORAGE LAYER (DRIZZLE ORM + POSTGRESQL / SUPABASE)
# ==============================================================================
# Primary PostgreSQL connection string (Supabase connection pooler or direct instance)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nammu_os

# Direct database connection for Drizzle migrations (Direct port 5432, bypassing PgBouncer if applicable)
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nammu_os

# Supabase Public API Gateway URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Publishable Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-publishable-key

# Supabase Public Anonymous API Key (Safe for browser client usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Server Service Role Key (RESTRICTED: Never expose to frontend/client bundle)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key


# ==============================================================================
#  3. DISTRIBUTED CACHING & PERFORMANCE (REDIS / UPSTASH)
# ==============================================================================
# Standard Redis connection URI (e.g., Redis Cloud, AWS ElastiCache, Local Redis 7)
# Leave blank to automatically use high-speed in-memory caching in local dev
REDIS_URL=redis://localhost:6379

# Upstash Serverless Redis REST API URL (For Edge / Vercel / Cloudflare environments)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io

# Upstash Serverless Redis REST API Token
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Default cache TTL for API proxies and file listings (in seconds)
CACHE_DEFAULT_TTL_SECONDS=300


# ==============================================================================
#  4. AUTHENTICATION & SECURITY KERNEL
# ==============================================================================
# Cryptographic secret key used for AES-256-GCM credential vault encryption and session tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=nammu_enterprise_super_secret_master_encryption_key_change_in_prod_32chars!

# Secure session cookie identifier
AUTH_COOKIE_NAME=nammu_os_session

# Session time-to-live in hours (Default: 336 hours = 14 days)
AUTH_SESSION_TTL_HOURS=336

# CORS Origin policy header (e.g., 'https://os.nammu.cloud' or '*' for development)
CORS_ORIGIN=http://localhost:3000


# ==============================================================================
#  5. MULTI-CLOUD STORAGE PROVIDERS (OAUTH & DIRECT CREDENTIALS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 5.1 Google Drive API (Google Cloud Console OAuth 2.0 Client)
# Scopes required: https://www.googleapis.com/auth/drive
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/accounts/google/callback

# ------------------------------------------------------------------------------
# 5.2 Microsoft OneDrive / Graph API (Azure Entra ID App Registration)
# Scopes required: Files.ReadWrite.All, offline_access, User.Read
# ------------------------------------------------------------------------------
ONEDRIVE_CLIENT_ID=your-azure-entra-client-id
ONEDRIVE_CLIENT_SECRET=your-azure-entra-client-secret
ONEDRIVE_TENANT_ID=common
ONEDRIVE_REDIRECT_URI=http://localhost:3000/api/accounts/onedrive/callback

# ------------------------------------------------------------------------------
# 5.3 Dropbox Platform (Dropbox App Console)
# Scopes required: files.content.read, files.content.write, files.metadata.read
# ------------------------------------------------------------------------------
DROPBOX_CLIENT_ID=your-dropbox-app-key
DROPBOX_CLIENT_SECRET=your-dropbox-app-secret
DROPBOX_REDIRECT_URI=http://localhost:3000/api/accounts/dropbox/callback

# ------------------------------------------------------------------------------
# 5.4 Yandex Disk API (Yandex OAuth)
# ------------------------------------------------------------------------------
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_REDIRECT_URI=http://localhost:3000/api/accounts/yandex/callback

# ------------------------------------------------------------------------------
# 5.5 Amazon AWS S3 & S3-Compatible Storage (Cloudflare R2, MinIO, Wasabi, Backblaze B2)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=nammu-os-virtual-storage
# Custom endpoint for R2 / MinIO (Optional)
# AWS_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 5.6 pCloud API (pCloud Developer Console)
# ------------------------------------------------------------------------------
PCLOUD_CLIENT_ID=your-pcloud-client-id
PCLOUD_CLIENT_SECRET=your-pcloud-client-secret
PCLOUD_API_HOSTNAME=api.pcloud.com


# ==============================================================================
#  6. CLOUDFLARE EDGE & CDN INTEGRATION (OPTIONAL)
# ==============================================================================
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id
